# Atlas Financials — variables de entorno

# Obligatorias en producción (la app no arranca sin ellas):
DATABASE_URL=postgresql://user:pass@host:5432/financials
SECRET_KEY=cambia-esto-por-un-secreto-de-al-menos-32-caracteres

# Entorno: development | production
ENV=development

# CORS: orígenes separados por coma. Vacío = sin CORS (misma-origen, el caso normal:
# FastAPI sirve la SPA). Solo se necesita si el frontend vive en otro dominio.
CORS_ORIGINS=

# Opcionales
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30
DOCS_ENABLED=false

# Perímetro: límite de intentos por IP (en memoria) y bloqueo de cuenta
RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
AGENT_RATE_PER_MINUTE=120

# CFDI: sellado y timbrado (ADR-017/018). Apagado por omisión: stamp/cancel responden 503.
# En producción sólo valen CFDI_FIRMANTE=kms y un proveedor real (aún no conectados).
# Para desarrollo: CFDI_FIRMANTE=local_pruebas con el CSD de prueba del SAT y CFDI_PROVEEDOR=simulado
# (o formas_digitales_pruebas con sus credenciales públicas de pruebas). Ver app/services/cfdi/configuracion.py.
CFDI_TIMBRADO_HABILITADO=false
# CFDI_FIRMANTE=local_pruebas
# CFDI_PROVEEDOR=simulado
# CFDI_CSD_PRUEBAS_CER=/ruta/CSD_Sucursal_1_EKU9003173C9.cer
# CFDI_CSD_PRUEBAS_KEY=/ruta/CSD_Sucursal_1_EKU9003173C9.key
# CFDI_CSD_PRUEBAS_CONTRASENA=12345678a
# FD_USUARIO=
# FD_CONTRASENA=
